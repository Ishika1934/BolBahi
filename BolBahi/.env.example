# BolBahi Environment Variables
MONGODB_URI=mongodb://127.0.0.1:27017/bolbahi
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Authentication
JWT_SECRET=replace_with_a_random_32_character_secret_key_here
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# LLM Provider
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Claude Provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Reminders & Email
RESEND_API_KEY=re_dummy_resend_api_key
MAIL_FROM=BolBahi <onboarding@resend.dev>
DEMO_EMAIL=demo@bolbahi.app

# Next.js Public
NEXT_PUBLIC_API_URL=http://localhost:4000

